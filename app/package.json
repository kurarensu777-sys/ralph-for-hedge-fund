{
  "name": "fund-cockpit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "fundd": "tsx server/fundd.ts",
    "build": "vite build",
    "start": "tsx server/fundd.ts --serve-dist",
    "prod": "node scripts/prod.mjs",
